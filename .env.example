# Load with: node --env-file=.env src/server.js
HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=http://127.0.0.1:3210
DATABASE_PATH=./data/relaydesk.sqlite
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters before first start.
ADMIN_PASSWORD=
# Live mode requires HTTPS public origin (terminate TLS at your reverse proxy).
DEMO_MODE=false
# JSON array; baseUrl includes any secret panel base path. IDs must be unique.
# Each approved inbound is a template that members can choose.
# Example only: confirm the API contract against your installed panel version.
PANELS_JSON=[]
# [{"id":"de","name":"Germany","baseUrl":"https://panel.example.com/secret-path","token":"SERVER_SIDE_TOKEN","inbounds":[{"id":1,"name":"Germany direct"}]}]
